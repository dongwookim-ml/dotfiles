{
  "env": {
    "CLAUDE_CODE_EXPERIMENTAL_AGENT_TEAMS": "1"
  },
  "attribution": {
    "commit": "",
    "pr": ""
  },
  "permissions": {
    "allow": [
      "Bash(latexmk -pdf -interaction=nonstopmode main.tex)",
      "Bash(latexmk -C main.tex)",
      "Bash(pdfinfo main.pdf)"
    ]
  },
  "statusLine": {
    "type": "command",
    "command": "npx -y ccstatusline@latest",
    "padding": 0
  },
  "enabledPlugins": {
    "github@claude-plugins-official": true,
    "swift-lsp@claude-plugins-official": true,
    "cc-gemini-plugin@cc-gemini-plugin": true,
    "caveman@caveman": true
  },
  "extraKnownMarketplaces": {
    "cc-gemini-plugin": {
      "source": {
        "source": "github",
        "repo": "thepushkarp/cc-gemini-plugin"
      }
    },
    "caveman": {
      "source": {
        "source": "github",
        "repo": "JuliusBrussee/caveman"
      }
    }
  },
  "skipDangerousModePermissionPrompt": true,
  "remoteControlAtStartup": false,
  "mcpServers": {
    "slurm": {
      "command": "ssh",
      "args": [
        "dongwookim@ai2",
        "cd /home1/dongwookim/slurm-mcp && .venv/bin/python server.py"
      ]
    }
  }
}
