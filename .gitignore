.DS_Store
*.swp
*.swo
*~

# Never commit private keys
ssh/.ssh/id_*
ssh/.ssh/*.pem
ssh/.ssh/known_hosts

# Machine-local ssh overrides
ssh/.ssh/config.local

# Claude hooks: track only custom scripts, not plugin-generated files or runtime state
claude/.claude/hooks/*
!claude/.claude/hooks/codex-plan-review.sh
