{
  "env": {
    "CLAUDE_CODE_EXPERIMENTAL_AGENT_TEAMS": "1"
  },
  "attribution": {
    "commit": "",
    "pr": ""
  },
  "permissions": {
    "allow": [
      "Bash(latexmk -pdf -interaction=nonstopmode main.tex)",
      "Bash(latexmk -C main.tex)",
      "Bash(pdfinfo main.pdf)"
    ]
  },
  "statusLine": {
    "type": "command",
    "command": "npx -y ccstatusline@latest",
    "padding": 0
  },
  "enabledPlugins": {
    "github@claude-plugins-official": true,
    "swift-lsp@claude-plugins-official": true,
    "humanize-korean@im-not-ai": true,
    "caveman@caveman": true
  },
  "extraKnownMarketplaces": {
    "openai-codex": {
      "source": {
        "source": "github",
        "repo": "openai/codex-plugin-cc"
      }
    },
    "im-not-ai": {
      "source": {
        "source": "github",
        "repo": "epoko77-ai/im-not-ai"
      }
    },
    "caveman": {
      "source": {
        "source": "github",
        "repo": "JuliusBrussee/caveman"
      }
    }
  },
  "effortLevel": "xhigh",
  "skipDangerousModePermissionPrompt": true,
  "remoteControlAtStartup": false,
  "mcpServers": {
    "slurm": {
      "command": "ssh",
      "args": [
        "dongwookim@ai2",
        "cd /home1/dongwookim/slurm-mcp && .venv/bin/python server.py"
      ]
    }
  }
}
